          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{adminToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"assignmentId\": {{emailTestAssignmentId}},\n  \"submissionText\": \"This is a test submission for AMP email notification testing. The assignment was completed successfully.\"\n}"
            },
            "url": "{{baseUrl}}/api/Submission"
          }
        },
        {
          "name": "?? Test 3: Grade Email Notification",
          "event": [
            {
              "listen": "test",
