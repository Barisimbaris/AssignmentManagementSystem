    },
    {
      "name": "?? Final AMP Dashboard Check",
      "item": [
        {
          "name": "AMP Admin Dashboard (Final Stats)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Final AMP admin dashboard stats', function () {",
                  "    pm.response.to.have.status(200);",
                  "    const response = pm.response.json();",
                  "    if (response.data) {",
                  "        console.log('?? FINAL AMP SYSTEM STATS:');",
